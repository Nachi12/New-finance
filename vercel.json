{
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "vercel-community/php@0.4.0"
    },
    {
      "src": "*.php",
      "use": "vercel-community/php@0.4.0"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
