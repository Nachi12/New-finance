{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-community/php@0.4.0"
    },
    "*.php": {
      "runtime": "vercel-community/php@0.4.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
